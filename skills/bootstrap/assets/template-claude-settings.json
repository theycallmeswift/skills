{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/claude-cloud-node26-path.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(<install>)",
      "Bash(<test>)",
      "Bash(<lint>)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease origin main:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --set-upstream origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin HEAD:refs/heads/main:*)",
      "Bash(git push origin +:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "mechaswift": {
      "source": {
        "source": "github",
        "repo": "theycallmeswift/skills"
      }
    }
  },
  "enabledPlugins": {
    "core@mechaswift": true
  }
}
